# DeepSeek / OpenAI 兼容配置示例
# 复制为 .env.local 后填写真实 Key；.env.local 不会被提交到 Git
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# MySQL（school 库；如使用其他实例请修改）
DB_URL=jdbc:mysql://localhost:3306/school?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=123456
